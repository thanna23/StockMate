rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A saved session (order list or restock): signed-in users only, expected
    // shape, tagged with the writer's own uid and the server time.
    function isValidSession() {
      let data = request.resource.data;
      return data.keys().hasOnly(['createdAt', 'itemCount', 'items', 'uid'])
          && data.uid == request.auth.uid
          && data.createdAt == request.time
          && data.items is list
          && data.items.size() <= 500
          && data.itemCount == data.items.size();
    }

    // History is shared by everyone using the app (anonymous auth), so any
    // signed-in user can read it. Entries can't be edited or deleted from the app.
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidSession();
      allow update, delete: if false;
    }

    match /restocks/{restockId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidSession();
      allow update, delete: if false;
    }
  }
}
