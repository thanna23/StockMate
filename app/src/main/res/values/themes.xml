<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.StockMate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sm_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sm_badge</item>
        <item name="android:windowBackground">@color/sm_navy</item>
    </style>

    <style name="EndAlertDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/sm_on_dark_muted</item>
        <item name="colorAccent">@color/sm_badge</item>
        <item name="android:fontFamily">casual</item>
        <item name="android:windowBackground">@drawable/rounded_dialog_background</item>
    </style>

    <style name="StartChoiceAlertDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="textColorAlertDialogListItem">@color/white</item>
        <item name="colorAccent">@color/sm_badge</item>
        <item name="android:fontFamily">casual</item>
        <item name="android:textAlignment">center</item>
        <item name="android:windowBackground">@drawable/rounded_dialog_background</item>
    </style>

    <style name="Theme.StockMate" parent="Base.Theme.StockMate" />

    <!-- Filled button for the main action on a screen. -->
    <style name="Widget.StockMate.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sm_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Outlined button for secondary actions on navy screens. -->
    <style name="Widget.StockMate.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/sm_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Rounded white card that holds a list. -->
    <style name="Widget.StockMate.ListCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/sm_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
    </style>

    <!-- Screen titles (keeps the app's playful casual font). -->
    <style name="TextAppearance.StockMate.Title" parent="">
        <item name="android:fontFamily">casual</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Circular image (profile picture). -->
    <style name="ShapeAppearance.StockMate.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
